---
import Base from '../layouts/Base.astro';
import PreviewGallery from '../components/PreviewGallery';
import { downloadUrl, socialLinks, supportEmail } from '../config';

const features = [
  { number: '01', title: 'Ventas sin vueltas', text: 'Registra productos, arma la venta y consulta el total desde un flujo rápido para el mostrador.' },
  { number: '02', title: 'Inventario en orden', text: 'Controla artículos y existencias, con búsqueda por nombre o código de barras.' },
  { number: '03', title: 'Números más claros', text: 'Revisa ventas y movimientos para entender cómo va tu negocio.' },
  { number: '04', title: 'Trabajo local', text: 'Tus ventas, productos e inventario se guardan en el teléfono para operar sin conexión continua.' },
];
---
<Base title="Tu negocio, en tus manos" description="MiniPOS reúne ventas, inventario y resultados en una app Android para pequeños negocios.">
  <section class="overflow-hidden bg-lilac">
    <div class="mx-auto grid max-w-7xl items-center gap-9 px-4 pb-14 pt-12 sm:px-8 sm:py-20 lg:grid-cols-[1.1fr_.9fr] lg:gap-16 lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-[#ddd4f2] bg-white px-4 py-2 text-xs font-extrabold uppercase tracking-[.12em] text-violet"><span class="size-2 rounded-full bg-violet"></span> MiniPOS para Android</p>
        <h1 class="mt-6 max-w-3xl font-display text-[clamp(2.5rem,9vw,4.8rem)] font-extrabold leading-[1.08] tracking-[-.05em]">Tu negocio, <span class="text-violet">en tus manos.</span></h1>
        <p class="mt-5 max-w-xl text-base leading-7 text-muted sm:text-lg sm:leading-8">Ventas, inventario y resultados diarios en una app hecha para trabajar desde tu teléfono, incluso sin conexión continua.</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {downloadUrl ? <a href={downloadUrl} class="inline-flex min-h-13 items-center justify-center rounded-2xl bg-violet px-7 font-bold text-white shadow-[0_7px_14px_rgba(108,59,255,.28)] transition hover:bg-[#5027d7]" rel="noopener noreferrer">Descargar para Android ↓</a> : <span class="inline-flex min-h-13 items-center justify-center rounded-2xl bg-[#e8e0ff] px-7 font-bold text-ink">Descarga próximamente</span>}
          <a href="#como-funciona" class="inline-flex min-h-13 items-center justify-center rounded-2xl border border-[#cfc1f2] bg-white px-7 font-bold text-ink transition hover:border-violet">Cómo empezar →</a>
        </div>
        <p class="mt-4 text-sm leading-6 text-muted">30 días de prueba · El pago se hace dentro de MiniPOS</p>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <div class="absolute -inset-8 rounded-full bg-[#e8e0ff] blur-3xl"></div>
        <div class="relative overflow-hidden rounded-[2rem] border border-[#ddd4f2] bg-white shadow-[0_22px_60px_-30px_rgba(35,26,56,.35)]">
          <div class="flex items-center gap-3 border-b border-[#ddd4f2] px-5 py-4"><img src="/app-icon.webp" width="44" height="44" alt="" class="rounded-xl" /><div><p class="font-display font-extrabold">MiniPOS</p><p class="text-xs text-muted">Tu punto de venta</p></div><span class="ml-auto rounded-full bg-[#e6f5ee] px-3 py-1 text-xs font-bold text-[#087a5b]">Listo</span></div>
          <div class="bg-lilac p-5 sm:p-6"><p class="text-xs font-bold uppercase tracking-[.14em] text-violet">Venta</p><p class="mt-2 font-display text-2xl font-extrabold">Una venta más simple</p><div class="mt-5 rounded-2xl border border-[#ddd4f2] bg-white px-4 py-3 text-sm text-muted">Buscar producto o escanear código <span class="float-right font-bold text-violet">⌕</span></div><div class="mt-4 space-y-2"><div class="flex items-center justify-between rounded-2xl bg-white px-4 py-4"><span class="font-semibold">Café molido</span><span class="font-bold text-violet">2 ×</span></div><div class="flex items-center justify-between rounded-2xl bg-white px-4 py-4"><span class="font-semibold">Leche</span><span class="font-bold text-violet">1 ×</span></div></div><div class="mt-4 flex items-center justify-between rounded-2xl bg-[#e8e0ff] px-4 py-4"><span class="text-sm font-semibold">Total de la venta</span><span class="font-display text-2xl font-extrabold">$ 740</span></div><div class="mt-3 rounded-2xl bg-violet px-4 py-3 text-center font-bold text-white">Cobrar</div></div>
          <div class="flex justify-around border-t border-[#ddd4f2] bg-white px-2 py-3 text-[11px] font-bold"><span class="text-violet">Venta</span><span class="text-muted">Resumen</span><span class="text-muted">IPV</span><span class="text-muted">Inventario</span><span class="text-muted">Historial</span></div>
        </div>
        <p class="relative mt-3 text-center text-xs text-muted">Vista ilustrativa de la app</p>
      </div>
    </div>
  </section>

  <section id="funciones" class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24">
    <div class="max-w-2xl"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Lo esencial, bien resuelto</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">Más tiempo para atender. Menos para buscar.</h2><p class="mt-5 text-lg leading-8 text-muted">Lo que necesitas a diario, organizado en un solo lugar.</p></div>
    <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{features.map((feature) => <article class="rounded-3xl border border-[#ddd4f2] bg-white p-6 shadow-[0_8px_24px_rgba(35,26,56,.06)]"><p class="font-display text-2xl font-extrabold text-violet">{feature.number}</p><h3 class="mt-5 font-display text-xl font-extrabold">{feature.title}</h3><p class="mt-3 leading-7 text-muted">{feature.text}</p></article>)}</div>
  </section>

  <section id="capturas" class="bg-white"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24"><PreviewGallery client:load /></div></section>

  <section id="como-funciona" class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]"><div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Primeros pasos</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">De instalar a vender, sin complicarte.</h2><p class="mt-5 text-lg leading-8 text-muted">Empieza con el período gratuito de 30 días. Después puedes elegir un plan desde la propia app.</p></div><ol class="space-y-4"><li class="flex gap-5 rounded-2xl border border-[#e8e1f4] p-6"><span class="font-display text-2xl font-extrabold text-violet">01</span><div><h3 class="font-display text-xl font-extrabold">Descarga e instala</h3><p class="mt-2 leading-7 text-muted">Instala el APK oficial en tu Android. Acepta la política de privacidad y selecciona tu provincia al comenzar.</p></div></li><li class="flex gap-5 rounded-2xl border border-[#e8e1f4] p-6"><span class="font-display text-2xl font-extrabold text-violet">02</span><div><h3 class="font-display text-xl font-extrabold">Prepara tu negocio</h3><p class="mt-2 leading-7 text-muted">Agrega productos, ajusta existencias y registra tu primera venta. El tutorial inicial te acompaña paso a paso.</p></div></li><li class="flex gap-5 rounded-2xl border border-[#e8e1f4] p-6"><span class="font-display text-2xl font-extrabold text-violet">03</span><div><h3 class="font-display text-xl font-extrabold">Elige un plan cuando lo necesites</h3><p class="mt-2 leading-7 text-muted">Dentro de MiniPOS, consulta los planes y el precio vigente, introduce el teléfono de pago, paga con el enlace o QR de uPagos y toca «Ya pagué · Verificar». El acceso se amplía cuando el pago queda confirmado.</p></div></li></ol></div>
  </section>

  <section class="bg-[#e9e1ff]"><div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-12 sm:px-8 lg:flex-row lg:items-center"><div><p class="font-display text-2xl font-extrabold">Tus datos de negocio se quedan contigo.</p><p class="mt-2 max-w-2xl leading-7 text-muted">Las ventas, los productos y el inventario viven en el dispositivo. Haz copias de seguridad antes de cambiar de teléfono o borrar la app.</p></div><a href="/politica-de-privacidad/" class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-violet px-5 font-bold text-violet hover:bg-white">Cómo tratamos tus datos →</a></div></section>

  <section id="contacto" class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-8 lg:grid-cols-2 lg:py-24"><div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Estamos cerca</p><h2 class="mt-4 font-display text-3xl font-extrabold sm:text-5xl">¿Tienes una pregunta?</h2><p class="mt-5 max-w-lg text-lg leading-8 text-muted">Escríbenos para consultas sobre el uso de MiniPOS, pagos o privacidad.</p></div><div class="rounded-[1.6rem] bg-nocturne p-6 text-white sm:p-8"><p class="text-sm font-bold text-[#cbbcf1]">Contacto</p>{supportEmail ? <a class="mt-3 inline-block break-all font-display text-2xl font-extrabold hover:underline" href={`mailto:${supportEmail}`}>{supportEmail}</a> : <p class="mt-3 font-display text-xl font-extrabold">Correo pendiente de publicación</p>}<div class="mt-8 border-t border-white/15 pt-6"><p class="text-sm font-bold text-[#cbbcf1]">Redes oficiales</p>{socialLinks.length ? <div class="mt-3 flex flex-wrap gap-4">{socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" class="font-bold hover:underline">{link.label} ↗</a>)}</div> : <p class="mt-3 text-[#d8cfe8]">Se publicarán aquí.</p>}</div></div></section>
</Base>
