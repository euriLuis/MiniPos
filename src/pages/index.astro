---
import Base from '../layouts/Base.astro';
import PhoneMockup from '../components/PhoneMockup';
import PreviewGallery from '../components/PreviewGallery';
import { downloadUrl } from '../config';

const features = [
  { number: '01', title: 'Ventas sin vueltas', text: 'Registra productos, arma la venta y consulta el total desde un flujo rápido para el mostrador.' },
  { number: '02', title: 'Inventario en orden', text: 'Controla artículos y existencias, con búsqueda por nombre o código de barras.' },
  { number: '03', title: 'Números más claros', text: 'Lleva tu IPV actualizado en todo momento, registra entradas, ventas, mermas y ten tu final siempre a la mano' },
  { number: '04', title: 'Trabajo local', text: 'Tus ventas, productos e inventario se guardan en el teléfono para operar sin conexión continua.' },
];

const steps = [
  { number: '01', title: 'Descarga e instala', text: 'Instala el APK oficial en tu Android. Acepta la política de privacidad y selecciona tu provincia al comenzar.' },
  { number: '02', title: 'Prepara tu negocio', text: 'Agrega productos, ajusta existencias y registra tu primera venta. El tutorial inicial te acompaña paso a paso.' },
  { number: '03', title: 'Elige un plan cuando lo necesites', text: 'Dentro de MiniPOS, consulta los planes y el precio vigente, introduce el teléfono de pago, paga con el enlace o QR de uPagos y toca «Ya pagué · Verificar». El acceso se amplía cuando el pago queda confirmado.' },
];
---
<Base title="Tu negocio, en tus manos" description="MiniPOS reúne ventas, inventario y resultados en una app Android para pequeños negocios.">
  <section class="hero-section overflow-hidden">
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-start gap-x-10 gap-y-3 px-4 pb-14 pt-4 sm:px-8 sm:pb-20 sm:pt-7 lg:min-h-[650px] lg:grid-cols-[1fr_1fr] lg:gap-x-12">
      <div class="relative z-10">
        <h1 class="max-w-2xl font-display text-[clamp(2.7rem,8vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-.06em]">Tu negocio, <span class="text-violet">en tus manos.</span></h1>
      </div>
      <div class="min-w-0">
        <div class="hero-art" aria-label="Capturas de MiniPOS en móviles">
          <div class="hero-art-halo" aria-hidden="true"></div>
          <PhoneMockup id="mockup-portada-resumen" screen="Resumen" className="hero-phone-back" />
          <PhoneMockup id="mockup-portada-venta" screen="Venta" screenshotSrc="/screenshots/ventaprinc.jpg" className="hero-phone-front" />
        </div>
        <p class="relative z-10 mx-auto mt-6 max-w-xl text-center text-base leading-7 text-muted sm:mt-12 sm:text-lg sm:leading-8">Ventas, inventario y resultados diarios en una app hecha para trabajar desde tu teléfono.</p>
        <p class="relative z-10 mt-4 text-center text-sm leading-6 text-muted">Pruebalo totalmente gratis por 30 días</p>
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true"></div>
  </section>

  <section id="funciones" class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Lo esencial, bien resuelto</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">Más tiempo para atender. Menos para buscar.</h2><p class="mt-5 text-lg leading-8 text-muted">Lo que necesitas a diario para gestionar tus ventas, y facilitar tu trabajo</p></div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">{features.map((feature) => <article class="feature-item text-center"><span class="feature-icon font-display text-xl font-extrabold text-violet">{feature.number}</span><h3 class="mt-5 font-display text-xl font-extrabold">{feature.title}</h3><p class="mt-3 leading-7 text-muted">{feature.text}</p></article>)}</div>
    </div>
  </section>

  <section id="como-funciona" class="steps-section overflow-hidden">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:gap-20 lg:py-24">
      <div class="steps-art">
        <div class="steps-art-ring" aria-hidden="true"></div>
        <div class="steps-brand-card" aria-hidden="true"><img src="/app-icon.webp" width="38" height="38" alt="" /><span>MiniPOS</span></div>
        <PhoneMockup id="mockup-pasos-inventario" screen="Inventario" className="steps-phone-back" />
        <PhoneMockup id="mockup-pasos-escaner" screen="Escáner" className="steps-phone-front" />
      </div>
      <div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Primeros pasos</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">De instalar a vender, sin complicarte.</h2><p class="mt-5 text-lg leading-8 text-muted">Empieza con el período gratuito de 30 días. Después puedes elegir un plan desde la propia app.</p>
        <ol class="steps-list mt-9 space-y-5">{steps.map((step) => <li class="flex gap-4"><span class="step-number shrink-0 font-display font-extrabold">{step.number}</span><div><h3 class="font-display text-lg font-extrabold">{step.title}</h3><p class="mt-1 leading-7 text-muted">{step.text}</p></div></li>)}</ol>
      </div>
    </div>
  </section>

  <section id="capturas" class="bg-white"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24"><PreviewGallery client:load /></div></section>

  <section id="contacto" class="contact-section overflow-hidden text-white">
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-8 lg:py-24">
      <p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#cbbcf1]">Estamos cerca</p>
      <h2 class="mt-4 font-display text-3xl font-extrabold sm:text-5xl">¿Tienes una pregunta?</h2>
      <p class="mx-auto mt-5 max-w-lg text-lg leading-8 text-[#d8cfe8]">Escríbenos para consultas sobre el uso de MiniPOS, pagos o privacidad.</p>
      <p class="mt-9 font-display text-2xl font-extrabold">Tu negocio, en tus manos.</p>
    </div>
  </section>

  <a href={downloadUrl} class="download-cta" aria-label="Descargar Aplicación, estado completo">
    <span class="download-cta-label">Descargar aplicación</span>
    <svg class="download-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v14m-6-6 6 6 6-6M4 21h16" /></svg>
  </a>
  <script>
    const downloadButton = document.querySelector<HTMLAnchorElement>('.download-cta');
    if (downloadButton) {
      const setCompact = (compact: boolean) => {
        if (downloadButton.classList.contains('is-compact') === compact) return;
        downloadButton.classList.toggle('is-compact', compact);
        downloadButton.setAttribute('aria-label', `Descargar Aplicación, estado ${compact ? 'compacto' : 'completo'}`);
      };
      let previousY = window.scrollY;
      let travel = 0;
      window.addEventListener('scroll', () => {
        const currentY = Math.max(0, window.scrollY);
        const delta = currentY - previousY;
        previousY = currentY;
        if (currentY < 16) {
          setCompact(false);
          travel = 0;
        } else if (delta) {
          travel = Math.sign(delta) === Math.sign(travel) ? travel + delta : delta;
          if (travel > 24) setCompact(true);
          else if (travel < -24) setCompact(false);
        }
      }, { passive: true });
    }
  </script>
</Base>
