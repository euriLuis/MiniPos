---
import Base from '../layouts/Base.astro';
import PhoneMockup from '../components/PhoneMockup';
import PreviewGallery from '../components/PreviewGallery';
import { downloadUrl, supportEmail } from '../config';

const features = [
  { number: '01', title: 'Registra ventas', text: 'Añade productos, ajusta cantidades y confirma el total en el mostrador.' },
  { number: '02', title: 'Consulta existencias', text: 'Busca productos por nombre o código de barras y revisa el inventario.' },
  { number: '03', title: 'Revisa tu IPV', text: 'Consulta inicio, entradas, ventas, mermas y final de cada producto.' },
  { number: '04', title: 'Trabaja sin conexión continua', text: 'Las ventas, los productos y el inventario se guardan en el teléfono.' },
];

const steps = [
  { number: '01', title: 'Descarga e instala', text: 'Instala el APK oficial en tu Android. Acepta la política de privacidad y selecciona tu provincia al comenzar.' },
  { number: '02', title: 'Prepara tu negocio', text: 'Agrega productos, ajusta existencias y registra tu primera venta. El tutorial inicial te acompaña paso a paso.' },
  { number: '03', title: 'Elige un plan después de la prueba', text: 'Consulta los planes desde $150 al mes y paga por transferencia desde la app.' },
];
---
<Base title="Ventas e inventario en tu teléfono" description="MiniPos, aplicación de teléfono para registrar y controlar las ventas de tu negocio, fácil de usar para que tus cierres sean rápidos.">
  <section class="hero-section overflow-hidden">
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-start gap-x-10 gap-y-3 px-4 pb-14 pt-4 sm:px-8 sm:pb-20 sm:pt-7 lg:min-h-[650px] lg:grid-cols-[1fr_1fr] lg:gap-x-12">
      <div class="relative z-10">
        <h1 class="max-w-2xl font-display text-[clamp(1.75rem,10vw,4.2rem)] font-bold leading-[1.04] tracking-[-.04em] lg:text-[clamp(2rem,5vw,4.2rem)]"><span class="block whitespace-nowrap">Ventas e Inventario</span><span class="block whitespace-nowrap text-violet">en tu teléfono.</span></h1>
      </div>
      <div class="min-w-0">
        <div class="hero-art" aria-label="Capturas de MiniPOS en móviles">
          <div class="hero-art-halo" aria-hidden="true"></div>
          <PhoneMockup id="mockup-portada-resumen" screen="Resumen" className="hero-phone-back" />
          <PhoneMockup id="mockup-portada-venta" screen="Venta" screenshotSrc="/screenshots/ventaprinc.jpg" className="hero-phone-front" />
        </div>
        <p class="relative z-10 mx-auto mt-6 max-w-xl text-center text-base leading-7 text-muted sm:mt-12 sm:text-lg sm:leading-8">Registra ventas, consulta existencias y revisa tu IPV, incluso sin conexión continua.</p>
        <p class="relative z-10 mt-4 text-center text-sm leading-6 text-muted">Prueba gratis durante 30 días.</p>
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true"></div>
  </section>

  <section id="funciones" class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center"><p class="text-sm font-semibold uppercase tracking-[.1em] text-violet">Funciones</p><h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-5xl">Ventas, existencias e IPV en un lugar.</h2><p class="mt-5 text-lg leading-8 text-muted">Registra movimientos y consulta los datos de tu negocio desde Android.</p></div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">{features.map((feature) => <article class="feature-item text-center"><span class="feature-icon font-display text-xl font-semibold text-violet">{feature.number}</span><h3 class="mt-5 font-display text-xl font-semibold">{feature.title}</h3><p class="mt-3 leading-7 text-muted">{feature.text}</p></article>)}</div>
    </div>
  </section>

  <section id="como-funciona" class="steps-section overflow-hidden">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:gap-20 lg:py-24">
      <div class="steps-art">
        <div class="steps-art-ring" aria-hidden="true"></div>
        <div class="steps-brand-card" aria-hidden="true"><img src="/app-icon.webp" width="38" height="38" alt="" /><span>MiniPOS</span></div>
        <PhoneMockup id="mockup-pasos-inventario" screen="Inventario" className="steps-phone-back" />
        <PhoneMockup id="mockup-pasos-escaner" screen="Escáner" className="steps-phone-front" />
      </div>
      <div><p class="text-sm font-semibold uppercase tracking-[.1em] text-violet">Primeros pasos</p><h2 class="mt-4 font-display text-3xl font-semibold tracking-tight sm:text-5xl">Instala, prepara y registra tu primera venta.</h2><p class="mt-5 text-lg leading-8 text-muted">Instala el APK en Android, añade tus productos y empieza la prueba de 30 días.</p>
        <ol class="steps-list mt-9 space-y-5">{steps.map((step) => <li class="flex gap-4"><span class="step-number shrink-0 font-display font-semibold">{step.number}</span><div><h3 class="font-display text-lg font-semibold">{step.title}</h3><p class="mt-1 leading-7 text-muted">{step.text}</p></div></li>)}</ol>
      </div>
    </div>
  </section>

  <section id="capturas" class="bg-white"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24"><PreviewGallery client:load /></div></section>

  <section id="contacto" class="contact-section overflow-hidden text-white">
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-8 lg:py-24">
      <p class="text-sm font-semibold uppercase tracking-[.1em] text-[#cbbcf1]">Contacto</p>
      <h2 class="mt-4 font-display text-3xl font-semibold sm:text-5xl">Habla con soporte de MiniPOS.</h2>
      <p class="mx-auto mt-5 max-w-lg text-lg leading-8 text-[#d8cfe8]">Consulta dudas sobre la app, los pagos o la privacidad.</p>
      <a href={`mailto:${supportEmail}`} class="mt-8 inline-flex min-h-11 items-center rounded-full bg-white px-6 font-semibold text-ink hover:bg-[#eee8ff]">Escribir a soporte</a>
    </div>
  </section>

  <a href={downloadUrl} class="download-cta" aria-label="Descargar Aplicación, estado completo">
    <span class="download-cta-label">Descargar aplicación</span>
    <svg class="download-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v14m-6-6 6 6 6-6M4 21h16" /></svg>
  </a>
  <script>
    const downloadButton = document.querySelector<HTMLAnchorElement>('.download-cta');
    if (downloadButton) {
      const setCompact = (compact: boolean) => {
        if (downloadButton.classList.contains('is-compact') === compact) return;
        downloadButton.classList.toggle('is-compact', compact);
        downloadButton.setAttribute('aria-label', `Descargar Aplicación, estado ${compact ? 'compacto' : 'completo'}`);
      };
      let previousY = window.scrollY;
      let travel = 0;
      window.addEventListener('scroll', () => {
        const currentY = Math.max(0, window.scrollY);
        const delta = currentY - previousY;
        previousY = currentY;
        if (currentY < 16) {
          setCompact(false);
          travel = 0;
        } else if (delta) {
          travel = Math.sign(delta) === Math.sign(travel) ? travel + delta : delta;
          if (travel > 24) setCompact(true);
          else if (travel < -24) setCompact(false);
        }
      }, { passive: true });
    }
  </script>
</Base>
