---
import Base from '../layouts/Base.astro';
import PreviewGallery from '../components/PreviewGallery';
import { downloadUrl, socialLinks, supportEmail } from '../config';

const features = [
  { number: '01', title: 'Ventas sin vueltas', text: 'Registra productos, arma la venta y consulta el total desde un flujo rápido para el mostrador.' },
  { number: '02', title: 'Inventario en orden', text: 'Controla artículos y existencias, con búsqueda por nombre o código de barras.' },
  { number: '03', title: 'Números más claros', text: 'Revisa ventas y movimientos para entender cómo va tu negocio.' },
  { number: '04', title: 'Trabajo local', text: 'Tus ventas, productos e inventario se guardan en el teléfono para operar sin conexión continua.' },
];
---
<Base title="Tu negocio, en tu bolsillo" description="MiniPOS reúne ventas, inventario y resultados en una app Android para pequeños negocios.">
  <section class="overflow-hidden bg-ink text-white">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:py-28">
      <div class="relative z-10">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[.17em] text-[#e2d8ff]"><span class="size-2 rounded-full bg-[#b7a1ff]"></span> Punto de venta para Android</p>
        <h1 class="max-w-3xl font-display text-5xl font-extrabold leading-[1.06] tracking-[-.055em] sm:text-6xl lg:text-[4.7rem]">Tu negocio más claro, <span class="text-[#beaaff]">en la palma de tu mano.</span></h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-[#ddd5ea]">Ventas, inventario y resultados diarios en una sola app. Trabaja desde tu teléfono, incluso cuando la conexión falla.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          {downloadUrl ? <a href={downloadUrl} class="inline-flex min-h-13 items-center justify-center rounded-full bg-white px-7 font-bold text-ink transition hover:bg-[#e9e1ff]" rel="noopener noreferrer">Descargar para Android ↓</a> : <span class="inline-flex min-h-13 items-center rounded-full bg-white/15 px-7 font-bold text-white">Descarga próximamente</span>}
          <a href="#como-funciona" class="inline-flex min-h-13 items-center justify-center rounded-full border border-white/30 px-7 font-bold transition hover:bg-white/10">Ver cómo funciona →</a>
        </div>
        <p class="mt-5 text-sm text-[#c9bfda]">Descarga directa desde Supabase Storage. El pago del plan se hace dentro de MiniPOS.</p>
      </div>
      <div class="relative mx-auto w-full max-w-lg">
        <div class="absolute inset-8 rounded-full bg-violet/50 blur-[95px]"></div>
        <div class="relative rotate-[-4deg] rounded-[2.7rem] border border-white/20 bg-[#33234d] p-4 shadow-2xl sm:p-6">
          <div class="rounded-[2rem] bg-white p-5 text-ink sm:p-7">
            <div class="flex items-center gap-3"><img src="/app-icon.png" width="52" height="52" alt="Icono de MiniPOS" class="rounded-xl" /><div><p class="font-display text-lg font-extrabold">MiniPOS</p><p class="text-xs text-muted">Tu negocio al día</p></div></div>
            <div class="mt-7 rounded-2xl bg-lilac p-5"><p class="text-sm font-semibold text-muted">Hoy en tu negocio</p><p class="mt-2 font-display text-4xl font-extrabold">Todo a la vista.</p><div class="mt-5 grid grid-cols-2 gap-3"><div class="rounded-xl bg-white p-4"><div class="mb-3 h-2 w-8 rounded bg-violet"></div><p class="font-bold">Ventas</p><p class="text-xs text-muted">En pocos pasos</p></div><div class="rounded-xl bg-white p-4"><div class="mb-3 h-2 w-8 rounded bg-[#e8b54c]"></div><p class="font-bold">Inventario</p><p class="text-xs text-muted">Siempre a mano</p></div></div></div>
            <div class="mt-4 flex items-center justify-between rounded-xl border border-[#e6def4] p-4 text-sm font-bold"><span>Listo para vender</span><span class="text-violet">→</span></div>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-7 rounded-2xl bg-white px-5 py-4 text-sm font-bold text-ink shadow-xl sm:-left-12">Sin conexión continua</div>
      </div>
    </div>
  </section>

  <section id="funciones" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="max-w-2xl"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Lo esencial, bien resuelto</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">Más tiempo para atender. Menos para buscar.</h2><p class="mt-5 text-lg leading-8 text-muted">Lo que necesitas a diario, organizado en un solo lugar.</p></div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{features.map((feature) => <article class="rounded-[1.6rem] border border-[#e8e1f4] bg-white p-7 shadow-[0_12px_40px_-30px_#3d275d70]"><p class="font-display text-3xl font-extrabold text-[#a992f1]">{feature.number}</p><h3 class="mt-7 font-display text-xl font-extrabold">{feature.title}</h3><p class="mt-3 leading-7 text-muted">{feature.text}</p></article>)}</div>
  </section>

  <section id="capturas" class="bg-lilac"><div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28"><PreviewGallery client:load /></div></section>

  <section id="como-funciona" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]"><div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Primeros pasos</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">De instalar a vender, sin complicarte.</h2><p class="mt-5 text-lg leading-8 text-muted">Empieza con el período gratuito de 30 días. Después puedes elegir un plan desde la propia app.</p></div><ol class="space-y-4"><li class="flex gap-5 rounded-2xl border border-[#e8e1f4] p-6"><span class="font-display text-2xl font-extrabold text-violet">01</span><div><h3 class="font-display text-xl font-extrabold">Descarga e instala</h3><p class="mt-2 leading-7 text-muted">Instala el APK oficial en tu Android. Acepta la política de privacidad y selecciona tu provincia al comenzar.</p></div></li><li class="flex gap-5 rounded-2xl border border-[#e8e1f4] p-6"><span class="font-display text-2xl font-extrabold text-violet">02</span><div><h3 class="font-display text-xl font-extrabold">Prepara tu negocio</h3><p class="mt-2 leading-7 text-muted">Agrega productos, ajusta existencias y registra tu primera venta. El tutorial inicial te acompaña paso a paso.</p></div></li><li class="flex gap-5 rounded-2xl border border-[#e8e1f4] p-6"><span class="font-display text-2xl font-extrabold text-violet">03</span><div><h3 class="font-display text-xl font-extrabold">Elige un plan cuando lo necesites</h3><p class="mt-2 leading-7 text-muted">Dentro de MiniPOS, consulta los planes y el precio vigente, introduce el teléfono de pago, paga con el enlace o QR de uPagos y toca «Ya pagué · Verificar». El acceso se amplía cuando el pago queda confirmado.</p></div></li></ol></div>
  </section>

  <section class="bg-[#e9e1ff]"><div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-12 sm:px-8 lg:flex-row lg:items-center"><div><p class="font-display text-2xl font-extrabold">Tus datos de negocio se quedan contigo.</p><p class="mt-2 max-w-2xl leading-7 text-muted">Las ventas, los productos y el inventario viven en el dispositivo. Haz copias de seguridad antes de cambiar de teléfono o borrar la app.</p></div><a href="/politica-de-privacidad/" class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-violet px-5 font-bold text-violet hover:bg-white">Cómo tratamos tus datos →</a></div></section>

  <section id="contacto" class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-8 lg:grid-cols-2 lg:py-28"><div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Estamos cerca</p><h2 class="mt-4 font-display text-3xl font-extrabold sm:text-5xl">¿Tienes una pregunta?</h2><p class="mt-5 max-w-lg text-lg leading-8 text-muted">Escríbenos para consultas sobre el uso de MiniPOS, pagos o privacidad.</p></div><div class="rounded-[1.6rem] bg-ink p-8 text-white"><p class="text-sm font-bold text-[#cbbcf1]">Contacto</p>{supportEmail ? <a class="mt-3 inline-block break-all font-display text-2xl font-extrabold hover:underline" href={`mailto:${supportEmail}`}>{supportEmail}</a> : <p class="mt-3 font-display text-xl font-extrabold">Correo pendiente de publicación</p>}<div class="mt-8 border-t border-white/15 pt-6"><p class="text-sm font-bold text-[#cbbcf1]">Redes oficiales</p>{socialLinks.length ? <div class="mt-3 flex flex-wrap gap-4">{socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" class="font-bold hover:underline">{link.label} ↗</a>)}</div> : <p class="mt-3 text-[#d8cfe8]">Se publicarán aquí.</p>}</div></div></section>
</Base>
