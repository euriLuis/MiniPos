---
import Base from '../layouts/Base.astro';
import PhoneMockup from '../components/PhoneMockup';
import PreviewGallery from '../components/PreviewGallery';
import { downloadUrl, socialLinks, supportEmail } from '../config';

const features = [
  { number: '01', title: 'Ventas sin vueltas', text: 'Registra productos, arma la venta y consulta el total desde un flujo rápido para el mostrador.' },
  { number: '02', title: 'Inventario en orden', text: 'Controla artículos y existencias, con búsqueda por nombre o código de barras.' },
  { number: '03', title: 'Números más claros', text: 'Revisa ventas y movimientos para entender cómo va tu negocio.' },
  { number: '04', title: 'Trabajo local', text: 'Tus ventas, productos e inventario se guardan en el teléfono para operar sin conexión continua.' },
];

const steps = [
  { number: '01', title: 'Descarga e instala', text: 'Instala el APK oficial en tu Android. Acepta la política de privacidad y selecciona tu provincia al comenzar.' },
  { number: '02', title: 'Prepara tu negocio', text: 'Agrega productos, ajusta existencias y registra tu primera venta. El tutorial inicial te acompaña paso a paso.' },
  { number: '03', title: 'Elige un plan cuando lo necesites', text: 'Dentro de MiniPOS, consulta los planes y el precio vigente, introduce el teléfono de pago, paga con el enlace o QR de uPagos y toca «Ya pagué · Verificar». El acceso se amplía cuando el pago queda confirmado.' },
];
---
<Base title="Tu negocio, en tus manos" description="MiniPOS reúne ventas, inventario y resultados en una app Android para pequeños negocios.">
  <section class="hero-section overflow-hidden">
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 pb-14 pt-12 sm:px-8 sm:py-20 lg:min-h-[650px] lg:grid-cols-[1fr_1fr] lg:gap-12 lg:py-20">
      <div class="relative z-10">
        <p class="inline-flex items-center gap-2 rounded-full border border-[#ddd4f2] bg-white/80 px-4 py-2 text-xs font-extrabold uppercase tracking-[.12em] text-violet"><span class="size-2 rounded-full bg-violet"></span> MiniPOS para Android</p>
        <h1 class="mt-7 max-w-2xl font-display text-[clamp(2.7rem,8vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-.06em]">Tu negocio, <span class="text-violet">en tus manos.</span></h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-muted sm:text-lg sm:leading-8">Ventas, inventario y resultados diarios en una app hecha para trabajar desde tu teléfono, incluso sin conexión continua.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {downloadUrl ? <a href={downloadUrl} class="inline-flex min-h-13 items-center justify-center rounded-full bg-violet px-7 font-bold text-white shadow-[0_8px_20px_rgba(108,59,255,.25)] transition hover:bg-[#5027d7]" rel="noopener noreferrer">Descargar para Android ↓</a> : <span class="inline-flex min-h-13 items-center justify-center rounded-full bg-[#e8e0ff] px-7 font-bold text-ink">Descarga próximamente</span>}
          <a href="#como-funciona" class="inline-flex min-h-13 items-center justify-center rounded-full border border-[#cfc1f2] bg-white px-7 font-bold text-ink transition hover:border-violet">Cómo empezar →</a>
        </div>
        <p class="mt-5 text-sm leading-6 text-muted">30 días de prueba · El pago se hace dentro de MiniPOS</p>
      </div>
      <div class="hero-art" aria-label="Vistas ilustrativas de MiniPOS en móviles">
        <div class="hero-art-halo" aria-hidden="true"></div>
        <PhoneMockup screen="Inventario" className="hero-phone-back" />
        <PhoneMockup screen="Venta" className="hero-phone-front" />
        <span class="hero-art-tag">Vistas ilustrativas de la app</span>
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true"></div>
  </section>

  <section id="funciones" class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center"><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Lo esencial, bien resuelto</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">Más tiempo para atender. Menos para buscar.</h2><p class="mt-5 text-lg leading-8 text-muted">Lo que necesitas a diario, organizado en un solo lugar.</p></div>
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">{features.map((feature) => <article class="feature-item text-center"><span class="feature-icon font-display text-xl font-extrabold text-violet">{feature.number}</span><h3 class="mt-5 font-display text-xl font-extrabold">{feature.title}</h3><p class="mt-3 leading-7 text-muted">{feature.text}</p></article>)}</div>
    </div>
  </section>

  <section id="como-funciona" class="steps-section overflow-hidden">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-8 lg:grid-cols-[.78fr_1.22fr] lg:gap-20 lg:py-24">
      <div class="steps-art">
        <div class="steps-art-ring" aria-hidden="true"></div>
        <div class="steps-brand-card" aria-hidden="true"><img src="/app-icon.webp" width="38" height="38" alt="" /><span>MiniPOS</span></div>
        <PhoneMockup screen="Inventario" className="steps-phone-back" />
        <PhoneMockup screen="Resumen" className="steps-phone-front" />
      </div>
      <div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-violet">Primeros pasos</p><h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">De instalar a vender, sin complicarte.</h2><p class="mt-5 text-lg leading-8 text-muted">Empieza con el período gratuito de 30 días. Después puedes elegir un plan desde la propia app.</p>
        <ol class="steps-list mt-9 space-y-5">{steps.map((step) => <li class="flex gap-4"><span class="step-number shrink-0 font-display font-extrabold">{step.number}</span><div><h3 class="font-display text-lg font-extrabold">{step.title}</h3><p class="mt-1 leading-7 text-muted">{step.text}</p></div></li>)}</ol>
      </div>
    </div>
  </section>

  <section id="capturas" class="bg-white"><div class="mx-auto max-w-7xl px-4 py-16 sm:px-8 lg:py-24"><PreviewGallery client:load /></div></section>

  <section class="bg-[#e9e1ff]"><div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 py-12 sm:px-8 lg:flex-row lg:items-center"><div><p class="font-display text-2xl font-extrabold">Tus datos de negocio se quedan contigo.</p><p class="mt-2 max-w-2xl leading-7 text-muted">Las ventas, los productos y el inventario viven en el dispositivo. Haz copias de seguridad antes de cambiar de teléfono o borrar la app.</p></div><a href="/politica-de-privacidad/" class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-violet px-5 font-bold text-violet hover:bg-white">Cómo tratamos tus datos →</a></div></section>

  <section id="contacto" class="contact-section overflow-hidden text-white"><div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-8 lg:grid-cols-[1.15fr_.85fr] lg:items-center lg:gap-20 lg:py-24"><div><p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#cbbcf1]">Estamos cerca</p><h2 class="mt-4 font-display text-3xl font-extrabold sm:text-5xl">¿Tienes una pregunta?</h2><p class="mt-5 max-w-lg text-lg leading-8 text-[#d8cfe8]">Escríbenos para consultas sobre el uso de MiniPOS, pagos o privacidad.</p><p class="mt-9 font-display text-2xl font-extrabold">Tu negocio, en tus manos.</p>{downloadUrl && <a href={downloadUrl} class="mt-5 inline-flex min-h-12 items-center rounded-full bg-violet px-6 font-bold text-white hover:bg-[#5027d7]" rel="noopener noreferrer">Descargar para Android ↓</a>}</div><div class="rounded-[1.6rem] border border-white/15 bg-white/5 p-6 sm:p-8"><p class="text-sm font-bold text-[#cbbcf1]">Contacto</p>{supportEmail ? <a class="mt-3 inline-block break-all font-display text-2xl font-extrabold hover:underline" href={`mailto:${supportEmail}`}>{supportEmail}</a> : <p class="mt-3 font-display text-xl font-extrabold">Correo pendiente de publicación</p>}<div class="mt-8 border-t border-white/15 pt-6"><p class="text-sm font-bold text-[#cbbcf1]">Redes oficiales</p>{socialLinks.length ? <div class="mt-3 flex flex-wrap gap-4">{socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer" class="font-bold hover:underline">{link.label} ↗</a>)}</div> : <p class="mt-3 text-[#d8cfe8]">Se publicarán aquí.</p>}</div></div></div></section>
</Base>
