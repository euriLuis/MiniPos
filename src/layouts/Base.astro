---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { downloadUrl, socialLinks, supportEmail } from '../config';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const pageTitle = `${title} | MiniPOS`;
const canonicalUrl = new URL(pathname, Astro.site);
const shareImageUrl = new URL('/minipos-compartir.png', Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090613" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="MiniPOS" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MiniPOS. Tu negocio, en tus manos. Ventas e inventario desde tu teléfono." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{pageTitle}</title>
    <Analytics />
  </head>
  <body class="font-sans antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3">Ir al contenido</a>
    <header class="relative z-20 border-b border-[#ddd4f2] bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-8 lg:py-4">
        <a class="flex min-h-12 items-center gap-2" href="/" aria-label="MiniPOS, inicio">
          <img src="/app-icon.png" width="42" height="42" alt="" class="rounded-xl" />
          <img src="/minipos-logotipo.svg" width="103" height="29" alt="MiniPOS" />
        </a>
        <nav aria-label="Navegación principal" class="hidden items-center gap-6 text-sm font-bold lg:flex">
          <a href="/#funciones" class="hover:text-violet">Funciones</a>
          <a href="/#capturas" class="hover:text-violet">La app</a>
          <a href="/#como-funciona" class="hover:text-violet">Cómo empezar</a>
          <a href="/#contacto" class="hover:text-violet">Contacto</a>
          {downloadUrl && <a href={downloadUrl} class="inline-flex min-h-12 items-center rounded-2xl bg-violet px-5 text-white hover:bg-[#4c25c3]" rel="noopener noreferrer">Descargar app ↗</a>}
        </nav>
        <details class="group relative lg:hidden">
          <summary class="flex min-h-12 cursor-pointer list-none items-center rounded-xl border border-[#ddd4f2] px-4 text-sm font-bold marker:hidden">Menú <span class="ml-2 text-violet group-open:rotate-180">⌄</span></summary>
          <nav aria-label="Navegación móvil" class="absolute right-0 top-[calc(100%+8px)] z-30 flex w-[min(19rem,calc(100vw-2rem))] flex-col rounded-2xl border border-[#ddd4f2] bg-white p-2 text-sm font-bold shadow-[0_14px_34px_#231a3826]">
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#funciones">Funciones</a>
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#capturas">La app</a>
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#como-funciona">Cómo empezar</a>
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#contacto">Contacto</a>
            {downloadUrl && <a class="rounded-xl bg-violet px-4 py-3 text-white" href={downloadUrl}>Descargar app</a>}
          </nav>
        </details>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="bg-nocturne text-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 sm:grid-cols-3 sm:px-8">
        <div><p class="font-display text-xl font-extrabold">MiniPOS</p><p class="mt-3 max-w-xs text-sm leading-6 text-[#d5cde6]">Tu punto de venta, claro y a mano. Hecho para trabajar desde Android.</p></div>
        <div><p class="font-bold">Explora</p><div class="mt-3 flex flex-col gap-3 text-sm text-[#d5cde6]"><a class="hover:text-white" href="/">Inicio</a><a class="hover:text-white" href="/terminos-y-condiciones/" aria-current={pathname.startsWith('/terminos') ? 'page' : undefined}>Términos y condiciones</a><a class="hover:text-white" href="/politica-de-privacidad/" aria-current={pathname.startsWith('/politica') ? 'page' : undefined}>Política de privacidad</a></div></div>
        <div><p class="font-bold">Hablemos</p>{supportEmail ? <a class="mt-3 block text-sm text-[#d5cde6] hover:text-white" href={`mailto:${supportEmail}`}>{supportEmail}</a> : <p class="mt-3 text-sm text-[#d5cde6]">Correo de contacto pendiente de publicación.</p>}<div class="mt-4 flex flex-wrap gap-4 text-sm">{socialLinks.map((link) => <a class="text-[#d5cde6] hover:text-white" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></div>
      </div>
      <div class="border-t border-white/10 px-5 py-5 text-center text-xs text-[#b9aecf]">© {new Date().getFullYear()} MiniPOS. Todos los derechos reservados.</div>
    </footer>
  </body>
</html>
