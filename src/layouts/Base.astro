---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { socialPlatforms, supportEmail } from '../config';
import SocialIcon from '../components/SocialIcon.astro';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const pathname = Astro.url.pathname;
const pageTitle = `${title} | MiniPOS`;
const canonicalUrl = new URL(pathname, Astro.site);
const shareImageUrl = new URL('/minipos-compartir-v3.jpg', Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090613" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="MiniPOS" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:secure_url" content={shareImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MiniPOS. Tu negocio, en tus manos. Ventas e inventario desde tu teléfono." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content="MiniPOS. Tu negocio, en tus manos." />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <title>{pageTitle}</title>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="font-sans antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3">Ir al contenido</a>
    <header class="relative z-20 border-b border-[#ddd4f2] bg-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-px sm:px-8 lg:py-1">
        <a class="flex min-h-12 items-center gap-2" href="/" aria-label="MiniPOS, inicio">
          <img src="/app-icon.webp" width="42" height="42" alt="" class="rounded-xl" />
          <img src="/minipos-logotipo.webp" width="103" height="29" alt="MiniPOS" />
        </a>
        <nav aria-label="Navegación principal" class="hidden items-center gap-6 text-sm font-medium lg:flex">
          <a href="/#funciones" class="hover:text-violet">Funciones</a>
          <a href="/#capturas" class="hover:text-violet">La app</a>
          <a href="/#como-funciona" class="hover:text-violet">Cómo empezar</a>
          <a href="/#contacto" class="hover:text-violet">Contacto</a>
        </nav>
        <details class="group relative lg:hidden">
          <summary class="flex min-h-12 cursor-pointer list-none items-center rounded-xl border border-[#ddd4f2] px-4 text-sm font-medium marker:hidden">Menú <span class="ml-2 text-violet group-open:rotate-180">⌄</span></summary>
          <nav aria-label="Navegación móvil" class="absolute right-0 top-[calc(100%+8px)] z-30 flex w-[min(19rem,calc(100vw-2rem))] flex-col rounded-2xl border border-[#ddd4f2] bg-white p-2 text-sm font-medium shadow-[0_14px_34px_#231a3826]">
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#funciones">Funciones</a>
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#capturas">La app</a>
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#como-funciona">Cómo empezar</a>
            <a class="rounded-xl px-4 py-3 hover:bg-lilac" href="/#contacto">Contacto</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="site-footer px-4 py-8 text-white sm:px-8 sm:py-12">
      <div class="footer-panel mx-auto max-w-7xl">
      <div class="grid gap-10 px-6 pb-10 pt-12 sm:grid-cols-3 sm:px-10 lg:px-12">
        <div><p class="font-display text-xl font-semibold">MiniPOS</p><p class="mt-3 max-w-xs text-sm leading-6 text-[#d5cde6]">Registra ventas y consulta el inventario en Android, incluso sin conexión continua.</p></div>
        <div><p class="font-semibold">Explora</p><div class="mt-3 flex flex-col gap-3 text-sm text-[#d5cde6]"><a class="underline underline-offset-4 hover:text-white" href="/">Inicio</a><a class="underline underline-offset-4 hover:text-white" href="/terminos-y-condiciones/" aria-current={pathname.startsWith('/terminos') ? 'page' : undefined}>Términos y condiciones</a><a class="underline underline-offset-4 hover:text-white" href="/politica-de-privacidad/" aria-current={pathname.startsWith('/politica') ? 'page' : undefined}>Política de privacidad</a><button type="button" id="analytics-preferences" class="min-h-11 self-start text-left underline underline-offset-4 hover:text-white">Preferencias de analítica</button></div></div>
        <div>
          <p class="font-semibold">Hablemos</p>
          {supportEmail && <a class="mt-3 block text-sm text-[#d5cde6] hover:text-white" href={`mailto:${supportEmail}`}>{supportEmail}</a>}
          <div class="mt-4 flex flex-wrap justify-center gap-2 text-sm" aria-label="Redes sociales">
            {socialPlatforms.filter((link) => link.label !== 'Instagram').map((link) => /^https:\/\//.test(link.url || '')
              ? <a class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-white/20 px-3 text-white transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href={link.url} target="_blank" rel="noopener noreferrer"><SocialIcon name={link.label} />{link.label}</a>
              : <span class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-white/10 px-3 text-[#b9aecf]" title="Enlace pendiente"><SocialIcon name={link.label} />{link.label}</span>)}
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 px-6 pt-6 text-center text-xs text-[#b9aecf] sm:px-10 lg:px-12">© <span data-current-year>{new Date().getFullYear()}</span> MiniPOS.<br />Todos los derechos reservados.</div>
      <div class="footer-brandline" aria-hidden="true"><span class="font-display">MiniPOS</span></div>
      </div>
    </footer>
    <aside id="analytics-consent" hidden aria-labelledby="analytics-consent-title" class:list={['fixed inset-x-4 z-[110] mx-auto max-w-sm rounded-xl border border-[#ddd4f2] bg-white p-3 shadow-[0_12px_32px_#231a3850] sm:p-4', pathname === '/' ? 'bottom-[calc(96px+env(safe-area-inset-bottom))]' : 'bottom-4']}>
      <h2 id="analytics-consent-title" class="sr-only">Cookies de analítica</h2>
      <p class="text-sm leading-5 text-muted">Google Analytics usa cookies opcionales para medir visitas. <a class="underline underline-offset-4" href="/politica-de-privacidad/">Privacidad</a></p>
      <div class="mt-2 flex gap-2">
        <button type="button" data-analytics-choice="declined" class="min-h-11 rounded-full border border-[#ddd4f2] px-4 text-sm font-semibold hover:bg-lilac">Rechazar</button>
        <button type="button" data-analytics-choice="accepted" class="min-h-11 rounded-full bg-violet px-4 text-sm font-semibold text-white hover:bg-ink">Aceptar</button>
      </div>
    </aside>
    <script>
      const consentKey = 'minipos-ga4-consent';
      const measurementId = 'G-6H8SSG0TFT';
      const banner = document.querySelector<HTMLElement>('#analytics-consent');
      let loaded = false;

      function loadGoogleAnalytics() {
        if (loaded) return;
        loaded = true;
        const dataLayer: unknown[][] = [];
        (window as Window & { dataLayer?: unknown[][] }).dataLayer = dataLayer;
        dataLayer.push(['consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' }]);
        dataLayer.push(['consent', 'update', { analytics_storage: 'granted' }]);
        dataLayer.push(['js', new Date()]);
        dataLayer.push(['config', measurementId, { allow_google_signals: false, allow_ad_personalization_signals: false }]);
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.append(script);
      }

      let choice: string | null = null;
      try { choice = localStorage.getItem(consentKey); } catch { /* Storage may be unavailable. */ }
      if (choice === 'accepted') loadGoogleAnalytics();
      else if (choice !== 'declined' && banner) banner.hidden = false;

      document.querySelector('#analytics-preferences')?.addEventListener('click', () => { if (banner) banner.hidden = false; });
      document.querySelectorAll<HTMLButtonElement>('[data-analytics-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          const nextChoice = button.dataset.analyticsChoice;
          try { localStorage.setItem(consentKey, nextChoice || 'declined'); } catch { /* Keep the current-page choice. */ }
          if (banner) banner.hidden = true;
          if (nextChoice === 'accepted') loadGoogleAnalytics();
          else if (loaded) {
            (window as Window & { dataLayer?: unknown[][] }).dataLayer?.push(['consent', 'update', { analytics_storage: 'denied' }]);
            for (const name of document.cookie.split(';').map((cookie) => cookie.trim().split('=')[0]).filter((name) => /^_ga(?:_|$)|^_gid$/.test(name))) {
              document.cookie = `${name}=; Max-Age=0; Path=/`;
              document.cookie = `${name}=; Max-Age=0; Path=/; Domain=${location.hostname}`;
            }
            location.reload();
          }
        });
      });
    </script>
    <script>
      const year = document.querySelector('[data-current-year]');
      if (year) year.textContent = String(new Date(Date.now()).getFullYear());
    </script>
  </body>
</html>
